{
  "name": "default",
  "tagType": "Provider",
  "tags": [
    {
      "name": "_types_",
      "tagType": "Folder",
      "tags": [
        {
          "name": "QC_MeasurementStation",
          "tagType": "UdtType",
          "parameters": {
            "StationLabel": { "dataType": "String", "value": "Unnamed Station" }
          },
          "tags": [
            { "name": "RecordsThisShift", "tagType": "AtomicTag", "valueSource": "memory", "dataType": "Int4", "value": 0 },
            { "name": "LastEntryOperator", "tagType": "AtomicTag", "valueSource": "memory", "dataType": "String", "value": "" },
            { "name": "LastEntryTimestamp", "tagType": "AtomicTag", "valueSource": "memory", "dataType": "DateTime" },
            { "name": "EntryPending", "tagType": "AtomicTag", "valueSource": "memory", "dataType": "Boolean", "value": false }
          ]
        },
        {
          "name": "QC_Lathe",
          "tagType": "UdtType",
          "typeId": "QC_MeasurementStation",
          "tags": [
            { "name": "Pending/Thickness1", "tagType": "AtomicTag", "valueSource": "memory", "dataType": "Float8", "value": 0.0 },
            { "name": "Pending/Thickness2", "tagType": "AtomicTag", "valueSource": "memory", "dataType": "Float8", "value": 0.0 },
            { "name": "Pending/Thickness3", "tagType": "AtomicTag", "valueSource": "memory", "dataType": "Float8", "value": 0.0 },
            { "name": "Pending/TargetThickness", "tagType": "AtomicTag", "valueSource": "memory", "dataType": "Float8", "value": 2.6 },
            {
              "name": "Pending/MaxDeviation",
              "tagType": "AtomicTag",
              "valueSource": "expression",
              "dataType": "Float8",
              "expression": "max(abs({[.]Pending/Thickness1} - {[.]Pending/TargetThickness}), abs({[.]Pending/Thickness2} - {[.]Pending/TargetThickness}), abs({[.]Pending/Thickness3} - {[.]Pending/TargetThickness}))",
              "alarms": [
                {
                  "name": "LatheThicknessOutOfSpec",
                  "mode": "OnCondition",
                  "setpointA": {
                    "bindType": "Expression",
                    "value": "{[.]Pending/MaxDeviation} > {[.]Config/ToleranceThickness}"
                  },
                  "priority": "Medium",
                  "enabled": true
                }
              ]
            },
            {
              "name": "Config/ToleranceThickness",
              "tagType": "AtomicTag",
              "valueSource": "memory",
              "dataType": "Float8",
              "value": 0.15
            }
          ]
        },
        {
          "name": "QC_DryerStage",
          "tagType": "UdtType",
          "typeId": "QC_MeasurementStation",
          "parameters": {
            "StagePosition": { "dataType": "String", "value": "INFEED" }
          },
          "tags": [
            { "name": "Pending/Thickness1", "tagType": "AtomicTag", "valueSource": "memory", "dataType": "Float8", "value": 0.0 },
            { "name": "Pending/Thickness2", "tagType": "AtomicTag", "valueSource": "memory", "dataType": "Float8", "value": 0.0 },
            { "name": "Pending/Thickness3", "tagType": "AtomicTag", "valueSource": "memory", "dataType": "Float8", "value": 0.0 },
            { "name": "Pending/Width", "tagType": "AtomicTag", "valueSource": "memory", "dataType": "Float8", "value": 0.0 },
            { "name": "Pending/MoistureMin", "tagType": "AtomicTag", "valueSource": "memory", "dataType": "Float8", "value": 0.0 },
            {
              "name": "Pending/MoistureMax",
              "tagType": "AtomicTag",
              "valueSource": "memory",
              "dataType": "Float8",
              "value": 0.0,
              "alarms": [
                {
                  "name": "DryerMoistureOutOfSpec",
                  "mode": "OnCondition",
                  "setpointA": {
                    "bindType": "Expression",
                    "value": "{[.]Pending/MoistureMax} > {[.]Config/MaxAllowableMoisture}"
                  },
                  "priority": "Medium",
                  "enabled": true
                }
              ]
            },
            {
              "name": "Config/MaxAllowableMoisture",
              "tagType": "AtomicTag",
              "valueSource": "memory",
              "dataType": "Float8",
              "value": 18.0
            }
          ]
        },
        {
          "name": "QC_FinishedPanel",
          "tagType": "UdtType",
          "typeId": "QC_MeasurementStation",
          "tags": [
            { "name": "Pending/ProductCode", "tagType": "AtomicTag", "valueSource": "memory", "dataType": "String", "value": "" },
            { "name": "Pending/FaceGrade", "tagType": "AtomicTag", "valueSource": "memory", "dataType": "String", "value": "" },
            { "name": "Pending/MoistureLHS", "tagType": "AtomicTag", "valueSource": "memory", "dataType": "Float8", "value": 0.0 },
            { "name": "Pending/MoistureMID", "tagType": "AtomicTag", "valueSource": "memory", "dataType": "Float8", "value": 0.0 },
            { "name": "Pending/MoistureRHS", "tagType": "AtomicTag", "valueSource": "memory", "dataType": "Float8", "value": 0.0 },
            {
              "name": "Pending/MaxMoistureReading",
              "tagType": "AtomicTag",
              "valueSource": "expression",
              "dataType": "Float8",
              "expression": "max({[.]Pending/MoistureLHS}, {[.]Pending/MoistureMID}, {[.]Pending/MoistureRHS})",
              "alarms": [
                {
                  "name": "FinishedPanelMoistureOutOfSpec",
                  "mode": "OnCondition",
                  "setpointA": {
                    "bindType": "Expression",
                    "value": "{[.]Pending/MaxMoistureReading} > {[.]Config/MaxAllowableMoisture}"
                  },
                  "priority": "Medium",
                  "enabled": true
                }
              ]
            },
            { "name": "Config/MaxAllowableMoisture", "tagType": "AtomicTag", "valueSource": "memory", "dataType": "Float8", "value": 18.0 }
          ]
        },
        {
          "name": "QC_ProcessLine",
          "tagType": "UdtType",
          "parameters": {
            "LineId": { "dataType": "String", "value": "MYRTLEFORD_L1" }
          },
          "tags": [
            { "name": "ActiveProduct", "tagType": "AtomicTag", "valueSource": "memory", "dataType": "String", "value": "" },
            { "name": "ActiveAlarmCount", "tagType": "AtomicTag", "valueSource": "memory", "dataType": "Int4", "value": 0 }
          ]
        }
      ]
    },
    {
      "name": "PortaPlywood",
      "tagType": "Folder",
      "tags": [
        {
          "name": "QualityControl",
          "tagType": "Folder",
          "tags": [
            {
              "name": "MYRTLEFORD_L1",
              "tagType": "Folder",
              "tags": [
                {
                  "name": "Line",
                  "tagType": "UdtInstance",
                  "typeId": "QC_ProcessLine",
                  "parameters": { "LineId": "MYRTLEFORD_L1" }
                },
                {
                  "name": "Lathe",
                  "tagType": "UdtInstance",
                  "typeId": "QC_Lathe",
                  "parameters": { "StationLabel": "Lathe quality control" }
                },
                {
                  "name": "DryerInfeed",
                  "tagType": "UdtInstance",
                  "typeId": "QC_DryerStage",
                  "parameters": { "StationLabel": "Dryer infeed quality control", "StagePosition": "INFEED" }
                },
                {
                  "name": "DryerOutfeed",
                  "tagType": "UdtInstance",
                  "typeId": "QC_DryerStage",
                  "parameters": { "StationLabel": "Dryer outfeed quality control", "StagePosition": "OUTFEED" }
                },
                {
                  "name": "FinishedPanel",
                  "tagType": "UdtInstance",
                  "typeId": "QC_FinishedPanel",
                  "parameters": { "StationLabel": "Finished panel thickness" }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
