{
  "params": {
    "tagPath": { "type": "string", "value": "" },
    "label": { "type": "string", "value": "Measurement" },
    "unit": { "type": "string", "value": "mm" },
    "step": { "type": "number", "value": 0.01 },
    "decimals": { "type": "number", "value": 2 }
  },
  "propConfig": {
    "params.tagPath": { "persistent": true }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": { "name": "root" },
    "props": { "direction": "column", "style": { "gap": "4px" } },
    "position": { "basis": "140px" },
    "children": [
      {
        "type": "ia.display.label",
        "meta": { "name": "fieldLabel" },
        "position": { "basis": "18px" },
        "props": {
          "text": "{view.params.label}",
          "style": { "fontSize": "12px", "fontWeight": "500" }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": { "name": "controlRow" },
        "position": { "basis": "44px" },
        "props": { "direction": "row", "alignItems": "center", "style": { "gap": "6px" } },
        "children": [
          {
            "type": "ia.input.button",
            "meta": { "name": "decrementButton" },
            "position": { "basis": "44px" },
            "props": { "text": "-", "style": { "fontSize": "18px", "classes": ["porta-button-step"] } },
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "import QC\n\tQC.adjust_pending(self.view.params.tagPath, -self.view.params.step, int(self.view.params.decimals))"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": { "name": "valueDisplay" },
            "position": { "basis": "grow" },
            "props": {
              "style": { "fontSize": "16px", "textAlign": "center" }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "tag",
                  "config": { "path": "{view.params.tagPath}", "mode": "indirect" },
                  "transforms": [
                    { "type": "expression", "expression": "toString(round({value}, {view.params.decimals})) + \" \" + {view.params.unit}" }
                  ]
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": { "name": "incrementButton" },
            "position": { "basis": "44px" },
            "props": { "text": "+", "style": { "fontSize": "18px", "classes": ["porta-button-step"] } },
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "import QC\n\tQC.adjust_pending(self.view.params.tagPath, self.view.params.step, int(self.view.params.decimals))"
                  }
                }
              }
            }
          }
        ]
      }
    ]
  },
  "meta": { "name": "measurement_field", "parentPath": "components" }
}
