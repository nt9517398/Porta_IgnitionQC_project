{
  "custom": {
    "lastSubmitMessage": {
      "value": ""
    },
    "lastSubmitSuccess": {
      "value": true
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "padding": "24px",
        "gap": "16px"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "header"
        },
        "position": {
          "basis": "36px"
        },
        "props": {
          "text": "Finished panel thickness",
          "style": {
            "fontSize": "20px",
            "fontWeight": "600",
            "color": "var(--porta-primary)",
            "classes": []
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "measurementRow"
        },
        "position": {
          "basis": "80px"
        },
        "props": {
          "direction": "row",
          "wrap": "wrap",
          "style": {
            "gap": "16px"
          }
        },
        "children": [
          {
            "type": "ia.embeddedview",
            "meta": {
              "name": "field_MoistureLHS"
            },
            "position": {
              "basis": "160px"
            },
            "props": {
              "path": "components/measurement_field",
              "params": {
                "tagPath": "[default]PortaPlywood/QualityControl/MYRTLEFORD_L1/FinishedPanel/Pending/MoistureLHS",
                "label": "Moisture LHS",
                "unit": "%",
                "step": 0.1,
                "decimals": 1
              }
            }
          },
          {
            "type": "ia.embeddedview",
            "meta": {
              "name": "field_MoistureMID"
            },
            "position": {
              "basis": "160px"
            },
            "props": {
              "path": "components/measurement_field",
              "params": {
                "tagPath": "[default]PortaPlywood/QualityControl/MYRTLEFORD_L1/FinishedPanel/Pending/MoistureMID",
                "label": "Moisture MID",
                "unit": "%",
                "step": 0.1,
                "decimals": 1
              }
            }
          },
          {
            "type": "ia.embeddedview",
            "meta": {
              "name": "field_MoistureRHS"
            },
            "position": {
              "basis": "160px"
            },
            "props": {
              "path": "components/measurement_field",
              "params": {
                "tagPath": "[default]PortaPlywood/QualityControl/MYRTLEFORD_L1/FinishedPanel/Pending/MoistureRHS",
                "label": "Moisture RHS",
                "unit": "%",
                "step": 0.1,
                "decimals": 1
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "actionRow"
        },
        "position": {
          "basis": "56px"
        },
        "props": {
          "direction": "row",
          "alignItems": "center",
          "style": {
            "gap": "16px"
          }
        },
        "children": [
          {
            "type": "ia.input.button",
            "meta": {
              "name": "enterButton"
            },
            "position": {
              "basis": "140px"
            },
            "props": {
              "text": "Enter",
              "style": {
                "fontSize": "16px",
                "classes": [
                  "porta-button-primary"
                ]
              }
            },
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "import QC\n\tparamMap = {\"moistureLhs\": \"Pending/MoistureLHS\", \"moistureMid\": \"Pending/MoistureMID\", \"moistureRhs\": \"Pending/MoistureRHS\"}\n\textraParams = {}\n\tsuccess, message = QC.submit_measurement(\n\t    stationPath='[default]PortaPlywood/QualityControl/MYRTLEFORD_L1/FinishedPanel',\n\t    queryPath='qc/finished_panel/insert_record',\n\t    projectName='site_quality_control',\n\t    paramMap=paramMap,\n\t    extraParams=extraParams,\n\t    operatorId=self.session.props.auth.user.userName,\n\t    shiftCode=self.session.custom.activeShift,\n\t    lineId='MYRTLEFORD_L1'\n\t)\n\tself.view.custom.lastSubmitMessage = message\n\tself.view.custom.lastSubmitSuccess = success"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "statusLabel"
            },
            "position": {
              "basis": "grow"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.custom.lastSubmitMessage"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "lastEntryLabel"
        },
        "position": {
          "basis": "20px"
        },
        "props": {
          "style": {
            "fontSize": "12px"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "tag",
              "config": {
                "path": "[default]PortaPlywood/QualityControl/MYRTLEFORD_L1/FinishedPanel/LastEntryOperator",
                "mode": "direct"
              },
              "transforms": [
                {
                  "type": "expression",
                  "expression": "\"Last entry by \" + {value}"
                }
              ]
            }
          }
        }
      }
    ]
  },
  "meta": {
    "name": "finished_panel",
    "parentPath": "finished_panel"
  }
}