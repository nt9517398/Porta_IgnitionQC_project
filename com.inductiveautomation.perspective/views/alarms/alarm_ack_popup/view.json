{
  "params": {
    "eventId": { "type": "number", "value": 0 },
    "displayPath": { "type": "string", "value": "" },
    "priority": { "type": "string", "value": "Medium" }
  },
  "custom": {
    "notesText": { "value": "" },
    "statusMessage": { "value": "" }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": { "name": "root" },
    "props": {
      "direction": "column",
      "style": { "padding": "20px", "gap": "12px", "width": "360px", "classes": ["porta-popup"] }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": { "name": "popupTitle" },
        "position": { "basis": "28px" },
        "props": { "text": "Acknowledge alarm", "style": { "fontSize": "18px", "fontWeight": "600", "color": "var(--porta-primary)" } }
      },
      {
        "type": "ia.display.label",
        "meta": { "name": "context" },
        "position": { "basis": "40px" },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": { "expression": "{view.params.displayPath} + \" -- \" + {view.params.priority} + \" priority\"" }
            }
          }
        },
        "props": { "style": { "fontSize": "13px" } }
      },
      {
        "type": "ia.input.text-area",
        "meta": { "name": "notesInput" },
        "position": { "basis": "80px" },
        "props": { "placeholder": "Notes (optional) -- e.g. cause, corrective action taken" },
        "propConfig": {
          "props.text": {
            "binding": { "type": "property", "config": { "path": "view.custom.notesText" }, "bidirectional": true }
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": { "name": "buttonRow" },
        "position": { "basis": "48px" },
        "props": { "direction": "row", "justify": "flex-end", "style": { "gap": "8px" } },
        "children": [
          {
            "type": "ia.input.button",
            "meta": { "name": "cancelButton" },
            "position": { "basis": "90px" },
            "props": { "text": "Cancel", "style": { "classes": ["porta-button-step"] } },
            "events": {
              "dom": {
                "onClick": {
                  "config": { "script": "system.perspective.closePopup(\"alarm_ack_popup\")" }
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": { "name": "confirmButton" },
            "position": { "basis": "140px" },
            "props": { "text": "Acknowledge", "style": { "classes": ["porta-button-primary"] } },
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "try:\n\t\tsystem.db.runNamedQuery('site_quality_control', 'qc/alarms/acknowledge', {\n\t\t\t'eventId': self.view.params.eventId,\n\t\t\t'ackUser': self.session.props.auth.user.userName,\n\t\t\t'ackNotes': self.view.custom.notesText\n\t\t})\n\t\tsystem.perspective.closePopup(\"alarm_ack_popup\")\n\texcept Exception as e:\n\t\tself.view.custom.statusMessage = \"Failed to acknowledge -- \" + str(e)"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.display.label",
        "meta": { "name": "statusLabel" },
        "position": { "basis": "18px" },
        "propConfig": {
          "props.text": { "binding": { "type": "property", "config": { "path": "view.custom.statusMessage" } } }
        },
        "props": { "style": { "fontSize": "12px", "color": "var(--qc-status-fault)" } }
      }
    ]
  },
  "meta": { "name": "alarm_ack_popup", "parentPath": "alarms" }
}
