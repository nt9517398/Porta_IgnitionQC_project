{
  "custom": {
    "rowLimit": { "value": 100 }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": { "name": "root" },
    "props": { "direction": "column", "style": { "padding": "24px", "gap": "16px" } },
    "children": [
      {
        "type": "ia.display.label",
        "meta": { "name": "header" },
        "position": { "basis": "36px" },
        "props": { "text": "Alarm status", "style": { "fontSize": "20px", "fontWeight": "600", "color": "var(--porta-primary)" } }
      },
      {
        "type": "ia.display.table",
        "meta": { "name": "alarmTable" },
        "position": { "basis": "grow" },
        "props": {
          "style": { "classes": ["porta-table"] },
          "columns": [
            { "field": "priority", "title": "Priority", "width": 100 },
            { "field": "display_path", "title": "Source", "width": 260 },
            { "field": "state", "title": "State", "width": 120 },
            { "field": "event_time", "title": "Time", "width": 180 },
            { "field": "ack_user", "title": "Ack by", "width": 140 }
          ]
        },
        "propConfig": {
          "props.data": {
            "binding": {
              "type": "named-query",
              "config": {
                "path": "qc/alarms/journal_history",
                "params": { "rowLimit": { "binding": { "type": "property", "config": { "path": "view.custom.rowLimit" } } } },
                "polling": { "enabled": true, "rate": 10 }
              }
            }
          }
        },
        "events": {
          "component": {
            "onRowClick": {
              "config": {
                "script": "row = self.props.data[event.rowIndex]\n\tif row['state'] != 'Acknowledged':\n\t\tsystem.perspective.openPopup(\n\t\t\tid=\"alarm_ack_popup\",\n\t\t\tview=\"alarms/alarm_ack_popup\",\n\t\t\tparams={\"eventId\": row['event_id'], \"displayPath\": row['display_path'], \"priority\": row['priority']},\n\t\t\tmodal=True\n\t\t)"
              }
            }
          }
        }
      }
    ]
  },
  "meta": { "name": "alarm_status", "parentPath": "alarms" }
}
