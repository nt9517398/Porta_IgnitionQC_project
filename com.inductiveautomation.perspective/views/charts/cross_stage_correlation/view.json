{
  "root": {
    "type": "ia.container.flex",
    "meta": { "name": "root" },
    "props": { "direction": "column", "style": { "padding": "24px", "gap": "16px" } },
    "children": [
      {
        "type": "ia.display.label",
        "meta": { "name": "header" },
        "position": { "basis": "36px" },
        "props": { "text": "Cross-stage thickness correlation", "style": { "fontSize": "20px", "fontWeight": "600", "color": "var(--porta-primary)" } }
      },
      {
        "type": "ia.chart.timeseries",
        "meta": { "name": "correlationChart" },
        "position": { "basis": "grow" },
        "props": {
          "series": [
            { "field": "lathe_thickness_1", "name": "Lathe", "color": "var(--porta-primary)" },
            { "field": "dryer_infeed_avg_thickness_1", "name": "Dryer infeed (3-batch avg)", "color": "var(--qc-status-standby)" },
            { "field": "dryer_outfeed_avg_thickness_1", "name": "Dryer outfeed (3-batch avg)", "color": "var(--qc-status-maintenance)" }
          ],
          "xField": "lathe_time"
        },
        "propConfig": {
          "props.data": {
            "binding": {
              "type": "named-query",
              "config": {
                "path": "qc/charts/cross_stage_correlation",
                "params": {
                  "lineId": { "binding": { "type": "expr", "config": { "expression": "\"MYRTLEFORD_L1\"" } } },
                  "startDate": { "binding": { "type": "expr", "config": { "expression": "dateArithmetic(now(), -7, \"days\")" } } },
                  "endDate": { "binding": { "type": "expr", "config": { "expression": "now()" } } }
                },
                "polling": { "enabled": true, "rate": 30 }
              }
            }
          }
        }
      }
    ]
  },
  "meta": { "name": "cross_stage_correlation", "parentPath": "charts" }
}
