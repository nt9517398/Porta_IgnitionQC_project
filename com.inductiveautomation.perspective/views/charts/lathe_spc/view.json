{
  "custom": {
    "startDate": { "value": null },
    "endDate": { "value": null }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": { "name": "root" },
    "props": { "direction": "column", "style": { "padding": "24px", "gap": "16px" } },
    "children": [
      {
        "type": "ia.display.label",
        "meta": { "name": "header" },
        "position": { "basis": "36px" },
        "props": { "text": "Lathe SPC control chart", "style": { "fontSize": "20px", "fontWeight": "600", "color": "var(--porta-primary)" } }
      },
      {
        "type": "ia.display.label",
        "meta": { "name": "disclaimer" },
        "position": { "basis": "20px" },
        "props": {
          "text": "UCL/LCL shown only for target thicknesses with a confirmed band in qc.quality_targets -- an unconfigured target renders with no control lines rather than a fabricated one.",
          "style": { "fontSize": "11px", "fontStyle": "italic" }
        }
      },
      {
        "type": "ia.chart.timeseries",
        "meta": { "name": "spcChart" },
        "position": { "basis": "grow" },
        "props": {
          "series": [
            { "field": "avg_thickness", "name": "Avg thickness", "color": "var(--porta-primary)" },
            { "field": "max_thickness", "name": "Max thickness", "color": "var(--neutral-50)" },
            { "field": "min_thickness", "name": "Min thickness", "color": "var(--neutral-50)" },
            { "field": "process_target", "name": "Target", "color": "var(--qc-status-standby)", "dashed": true },
            { "field": "ucl", "name": "UCL", "color": "var(--qc-status-fault)", "dashed": true },
            { "field": "lcl", "name": "LCL", "color": "var(--qc-status-fault)", "dashed": true }
          ],
          "xField": "batch_time"
        },
        "propConfig": {
          "props.data": {
            "binding": {
              "type": "named-query",
              "config": {
                "path": "qc/charts/lathe_spc",
                "params": {
                  "lineId": { "binding": { "type": "expr", "config": { "expression": "\"MYRTLEFORD_L1\"" } } },
                  "startDate": { "binding": { "type": "expr", "config": { "expression": "dateArithmetic(now(), -7, \"days\")" } } },
                  "endDate": { "binding": { "type": "expr", "config": { "expression": "now()" } } }
                },
                "polling": { "enabled": true, "rate": 30 }
              }
            }
          }
        }
      }
    ]
  },
  "meta": { "name": "lathe_spc", "parentPath": "charts" }
}
