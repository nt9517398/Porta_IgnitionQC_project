{
  "root": {
    "type": "ia.container.flex",
    "meta": { "name": "root" },
    "props": {
      "direction": "row",
      "alignItems": "center",
      "style": { "height": "56px", "padding": "0 16px", "gap": "24px", "classes": ["porta-header"] }
    },
    "children": [
      {
        "type": "ia.display.image",
        "meta": { "name": "logo" },
        "position": { "basis": "120px" },
        "props": { "source": "porta_logo_converted.png", "style": { "objectFit": "contain", "height": "32px" } }
      },
      {
        "type": "ia.container.flex",
        "meta": { "name": "navItems" },
        "position": { "basis": "grow" },
        "props": { "direction": "row", "style": { "gap": "4px" } },
        "children": [
          { "type": "ia.input.link", "meta": { "name": "navLathe" },
            "props": { "text": "Lathe", "targetURL": "/lathe", "style": { "classes": ["porta-nav-item"] } } },
          { "type": "ia.input.link", "meta": { "name": "navDryerInfeed" },
            "props": { "text": "Dryer infeed", "targetURL": "/dryer-infeed", "style": { "classes": ["porta-nav-item"] } } },
          { "type": "ia.input.link", "meta": { "name": "navDryerOutfeed" },
            "props": { "text": "Dryer outfeed", "targetURL": "/dryer-outfeed", "style": { "classes": ["porta-nav-item"] } } },
          { "type": "ia.input.link", "meta": { "name": "navFinishedPanel" },
            "props": { "text": "Finished panel", "targetURL": "/finished-panel", "style": { "classes": ["porta-nav-item"] } } },
          { "type": "ia.input.link", "meta": { "name": "navSpc" },
            "props": { "text": "SPC", "targetURL": "/spc", "style": { "classes": ["porta-nav-item"] } } },
          { "type": "ia.input.link", "meta": { "name": "navCorrelation" },
            "props": { "text": "Correlation", "targetURL": "/correlation", "style": { "classes": ["porta-nav-item"] } } },
          {
            "type": "ia.input.link", "meta": { "name": "navAlarms" },
            "props": { "text": "Alarms", "targetURL": "/alarms", "style": { "classes": ["porta-nav-item"] } },
            "propConfig": {
              "props.visible": {
                "binding": {
                  "type": "expr",
                  "config": { "expression": "hasRole({session.props.auth.user}, \"Supervisor\") || hasRole({session.props.auth.user}, \"Engineer\")" }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.input.dropdown",
        "meta": { "name": "shiftSelector" },
        "position": { "basis": "110px" },
        "props": {
          "options": [
            { "label": "Day shift", "value": "DAY" },
            { "label": "Afternoon shift", "value": "AFTERNOON" },
            { "label": "Night shift", "value": "NIGHT" }
          ],
          "style": { "classes": ["porta-nav-item"] }
        },
        "propConfig": {
          "props.value": {
            "binding": {
              "type": "property",
              "config": { "path": "session.custom.activeShift" },
              "bidirectional": true
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": { "name": "activeAlarmBadge" },
        "position": { "basis": "80px" },
        "props": { "style": { "color": "#FFFFFF", "fontWeight": "600" } },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "tag",
              "config": { "path": "[default]PortaPlywood/QualityControl/MYRTLEFORD_L1/Line/ActiveAlarmCount", "mode": "direct" },
              "transforms": [{ "type": "expression", "expression": "toString({value}) + \" active\"" }]
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": { "name": "operatorLabel" },
        "position": { "basis": "160px" },
        "props": { "style": { "color": "#FFFFFF", "fontSize": "13px", "textAlign": "right" } },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": { "path": "session.props.auth.user.userName" },
              "transforms": [{ "type": "expression", "expression": "{value} + \" -- \" + {session.custom.activeShift}" }]
            }
          }
        }
      }
    ]
  },
  "meta": { "name": "nav_shell", "parentPath": "shell" }
}
